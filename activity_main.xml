<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9C4"
    android:padding="20dp">
    <TextView android:id="@+id/timeTxt" android:text="Time: 30" android:textSize="24sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/scoreTxt" android:text="Coins: 0" android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/msgTxt" android:text="Tap to Start!" android:textSize="18sp" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Button android:id="@+id/tapBtn" android:text="💰 TAP COIN! 💰" android:textSize="30sp" android:layout_width="300dp" android:layout_height="300dp" android:layout_marginTop="40dp" android:backgroundTint="#FFD700"/>
</LinearLayout>
